# Temporary holding redirect — remove this block once the new site is ready to launch.
# Sends all traffic to /soon/, except:
# - /soon itself (avoid a redirect loop)
# - /assets (so /soon/ can load the logo)
# - the App Store–required T1 Expenses pages (/privacy-policy, /delete-account, /t1)
# - /preview (sets a bypass cookie, see /preview/index.html)
# - anyone who already has the tomos_preview cookie (set by visiting /preview)
RewriteEngine On
RewriteCond %{HTTP_COOKIE} !tomos_preview=1
RewriteCond %{REQUEST_URI} !^/soon
RewriteCond %{REQUEST_URI} !^/assets
RewriteCond %{REQUEST_URI} !^/privacy-policy
RewriteCond %{REQUEST_URI} !^/delete-account
RewriteCond %{REQUEST_URI} !^/t1
RewriteCond %{REQUEST_URI} !^/preview
RewriteRule ^(.*)$ /soon/ [R=302,L]
